# Meta / Instagram Graph API
# Copie este arquivo para .env.local e preencha com as credenciais do Fernando.
#
# Suporta dois esquemas (preferimos o "novo" Instagram Login, sem Facebook):
#
#   1) NOVO Instagram Login (recomendado)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
#
#   2) LEGACY Facebook Login (fallback automático)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
#
# As credenciais já em uso pelo PRODIA estão em:
#   _infra/instagram-dashboard/.env.local
# (use os mesmos valores aqui).
#
# ─────────────────────────────────────────────────────────────────
# Postgres conexão (Coolify injeta automaticamente em prod via env vars do app)
# Dev local: postgres://user:pass@localhost:5432/dropstudios_meta_dev
DATABASE_URL=
#
# ─────────────────────────────────────────────────────────────────
# Produção: env vars vivem no painel Coolify (VPS Drop), NÃO commitar `.env.production`.
# Para overrides locais use `.env.local` (gitignored).
